diff --git a/src/infra/outbound/delivery-error-guard.ts b/src/infra/outbound/delivery-error-guard.ts
new file mode 100644
index 0000000000..aaebd05c8f
--- /dev/null
+++ b/src/infra/outbound/delivery-error-guard.ts
@@ -0,0 +1,16 @@
+import type { DeliveryError } from "./deliver.js";
+
+// Type-only import keeps this module free of runtime dependency on deliver.js,
+// so callers in cold-startup / retry-guard code paths can check for a partial
+// delivery failure without eagerly loading the outbound delivery module.
+//
+// Matches by `name` + presence of `sentBeforeError` array. A third-party
+// adapter throwing a same-named error without the shape falls through to
+// the caller's generic error handling instead of crashing on undefined.
+export function isDeliveryError(err: unknown): err is DeliveryError {
+  return (
+    err instanceof Error &&
+    err.name === "DeliveryError" &&
+    Array.isArray((err as { sentBeforeError?: unknown }).sentBeforeError)
+  );
+}
